# Which AI to use: gemini | groq | claude | local   (local = no AI, keyword answers only)
LLM_PROVIDER=gemini

# Free key: https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACKS=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-flash-latest

# Optional backups
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
